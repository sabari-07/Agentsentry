# ---------------------------------------------------------------------------
# AgentSentry AI - backend configuration
# Copy this file to `.env` (same folder) and fill in real values.
# The real .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of origins allowed to call the API (the frontend dev server).
# Vite may pick 5174/5175 if 5173 is busy, so a few fallbacks are included.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- AWS credentials (read-only usage is expected) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: only when using temporary/STS credentials.
AWS_SESSION_TOKEN=

# --- AWS resources ---
# DynamoDB table that stores incident records, PR links and verification results.
INCIDENT_TABLE_NAME=agentsentry-incidents
# The IAM principal (user/role name) the agent uses, for filtering CloudTrail audit.
AGENT_IAM_PRINCIPAL=agentsentry-agent

# --- GitHub (for opening remediation PRs) ---
GITHUB_TOKEN=
GITHUB_REPO=your-org/agentsentry-ai
GITHUB_BASE_BRANCH=main

# --- Behaviour ---
# Minutes the verification loop waits/inspects before confirming a fix held.
VERIFICATION_WINDOW_MINUTES=5
# Set to "true" to run against in-memory mock data instead of live AWS (great for demos/dev).
USE_MOCK_DATA=true
